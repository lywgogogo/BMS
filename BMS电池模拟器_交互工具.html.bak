</table>

<h3>对比表说明</h3>
<table>
<tr><th>列</th><th>含义</th></tr>
<tr><td>硬件(mV)</td><td>来自串口 JSON 的实时数据</td></tr>
<tr><td>软件(mV)</td><td>根据当前电位器设置计算的理论值</td></tr>
<tr><td>偏差</td><td>硬件 − 软件: <10mV 🟢 / 10~50mV 🟡 / >50mV 🔴</td></tr>
<tr><td>状态</td><td>硬件值是否过压/欠压 + 偏差是否异常</td></tr>
</table>
`,

  'tab-trouble': `
<h3>常见问题排查</h3>
<table>
<tr><th>问题</th><th>可能原因</th><th>解决方法</th></tr>
<tr><td>LM317 输出电压不对</td><td>R1/R2 阻值不对或焊错</td><td>万用表测 R1=240Ω, R2=200Ω→电位器</td></tr>
<tr><td>拧电位器所有节一起变</td><td>ADJ 基准接线错误 (接到 GND 了)</td><td>Un 的 ADJ 必须接 B(n-1)，不是 GND</td></tr>
<tr><td>某节电压调不动</td><td>电位器损坏 / 虚焊</td><td>万用表测电位器中间脚对两端阻值</td></tr>
<tr><td>LM317 发烫</td><td>压差过大</td><td>加散热片或提高最小电压</td></tr>
<tr><td>串口连接失败</td><td>端口被占用 / 浏览器不支持</td><td>关闭串口助手；用 Chrome/Edge</td></tr>
<tr><td>串口收到乱码</td><td>波特率不匹配</td><td>确认 MCU 和浏览器波特率一致</td></tr>
<tr><td>对比表显示"等待串口数据"</td><td>MCU 没有发送 JSON</td><td>用串口助手确认 MCU 实际输出</td></tr>
<tr><td>波形卡住不更新</td><td>点了"已冻结"</td><td>点"自动滚动"或双击波形恢复</td></tr>
<tr><td>网页打不开</td><td>文件损坏或路径问题</td><td>重新从 GitHub 下载 / 刷新 Netlify 部署</td></tr>
</table>

<h3>技术参数速查</h3>
<table>
<tr><th>参数</th><th>数值</th></tr>
<tr><td>单节电压范围</td><td>2.29V ~ 4.90V</td></tr>
<tr><td>过压阈值 (OV)</td><td>4.25V</td></tr>
<tr><td>欠压阈值 (UV)</td><td>2.50V</td></tr>
<tr><td>输入电源</td><td>24V DC / ≥500mA</td></tr>
<tr><td>波形缓冲区</td><td>6000 点 (10min@10Hz)</td></tr>
<tr><td>串口默认参数</td><td>115200 · 8N1</td></tr>
</table>
`,
};

function initHelpModal() {
  const overlay = document.getElementById('help-overlay');
  const body = document.getElementById('help-body');

  // Open
  document.getElementById('btn-help').addEventListener('click', () => {
    overlay.classList.add('show');
    switchTab('tab-overview');
  });

  // Close
  document.getElementById('btn-help-close').addEventListener('click', () => {
    overlay.classList.remove('show');
  });
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('show');
  });

  // Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') overlay.classList.remove('show');
  });

  // Tab switching
  function switchTab(tabId) {
    document.querySelectorAll('.help-tab').forEach(t => t.classList.remove('active'));
    document.querySelector(`[data-tab="${tabId}"]`).classList.add('active');
    body.innerHTML = HELP_CONTENT[tabId] || '';
  }

  document.querySelectorAll('.help-tab').forEach(tab => {
    tab.addEventListener('click', () => switchTab(tab.dataset.tab));
  });
}

// ============================================================
// INIT
// ============================================================
function init() {
  renderAll();
  renderPresets();
  initHelpModal();

  // Check WebSerial support
  if (!('serial' in navigator)) {
    document.getElementById('no-serial-warn').style.display = 'block';
    document.getElementById('btn-select-port').disabled = true;
    document.getElementById('btn-select-port').textContent = '⚠ 浏览器不支持';
  }

  // Serial panel event listeners
  document.getElementById('btn-select-port').addEventListener('click', serialConnect);
  document.getElementById('btn-disconnect').addEventListener('click', serialDisconnect);

  // Chart interaction: auto-scroll / reset / clear
  document.getElementById('btn-auto-scroll').addEventListener('click', () => {
    chartAutoScroll = !chartAutoScroll;
    if (chartAutoScroll) { chartViewStart = null; chartViewEnd = null; }
    drawChart();
  });
  document.getElementById('btn-reset-view').addEventListener('click', () => {
    chartAutoScroll = true;
    chartViewStart = null;
    chartViewEnd = null;
    drawChart();
  });
  document.getElementById('btn-clear-chart').addEventListener('click', () => {
    chartHistory = [];
    chartVisibility = [true, true, true, true, true];
    chartAutoScroll = true;
    chartViewStart = null;
    chartViewEnd = null;
    drawChart();
    renderChartLegend();
  });

  // Chart mouse: wheel zoom
  const canvas = document.getElementById('chart-canvas');
  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    const total = chartHistory.length;
    if (total < 2) return;

    // Determine current visible window size
    let vStart, vEnd;
    if (chartAutoScroll) {
      const win = chartViewStart ? (chartViewEnd - chartViewStart) : Math.min(120, total);
      vEnd = total - 1;
      vStart = Math.max(0, vEnd - win + 1);
    } else {
      vStart = Math.max(0, chartViewStart || 0);
      vEnd = Math.min(total - 1, chartViewEnd || (total - 1));
    }
    const win = vEnd - vStart + 1;

    // Zoom: deltaY < 0 = zoom in, > 0 = zoom out
    const factor = e.deltaY < 0 ? 0.7 : 1.4;
    const newWin = Math.max(10, Math.min(total, Math.round(win * factor)));

    // Keep center point
    const center = (vStart + vEnd) / 2;
    const newStart = Math.max(0, Math.round(center - newWin / 2));
    const newEnd = Math.min(total - 1, newStart + newWin - 1);

    chartAutoScroll = (newEnd >= total - 1); // snap to auto if zoomed to end
    chartViewStart = newStart;
    chartViewEnd = newEnd;
    drawChart();
  }, { passive: false });

  // Chart mouse: drag to pan
  canvas.addEventListener('mousedown', (e) => {
    chartDragStart = e.offsetX;
    const total = chartHistory.length;
    if (chartAutoScroll) {
      const win = chartViewStart ? (chartViewEnd - chartViewStart) : Math.min(120, total);
      chartViewEnd = total - 1;
      chartViewStart = Math.max(0, chartViewEnd - win + 1);
      chartAutoScroll = false;
    }
    chartDragViewStart = chartViewStart;
    canvas.style.cursor = 'grabbing';
  });

  canvas.addEventListener('mousemove', (e) => {
    if (chartDragStart === null) return;
    const total = chartHistory.length;
    if (total < 2) return;
    const win = (chartViewEnd || (total-1)) - (chartViewStart || 0) + 1;
    const W = canvas.width, ml = 60, mr = 20, pw = W - ml - mr;
    const dx = e.offsetX - chartDragStart;
    const dPoints = -Math.round(dx / pw * win);
    const newStart = Math.max(0, chartDragViewStart + dPoints);
    const newEnd = Math.min(total - 1, newStart + win - 1);
    chartViewStart = newStart;
    chartViewEnd = newEnd;
    chartAutoScroll = (newEnd >= total - 1);
    drawChart();
  });

  canvas.addEventListener('mouseup', () => {
    chartDragStart = null;
    canvas.style.cursor = 'grab';
  });
  canvas.addEventListener('mouseleave', () => {
    chartDragStart = null;
    canvas.style.cursor = 'grab';
  });

  // Double-click: reset
  canvas.addEventListener('dblclick', () => {
    chartAutoScroll = true;
    chartViewStart = null;
    chartViewEnd = null;
    drawChart();
  });
  document.getElementById('btn-toggle-protocol').addEventListener('click', () => {
    const el = document.getElementById('protocol-detail');
    const btn = document.getElementById('btn-toggle-protocol');
    if (el.style.display === 'none') { el.style.display = 'block'; btn.textContent = '协议说明 ▾'; }
    else { el.style.display = 'none'; btn.textContent = '协议说明 ▸'; }
  });
  document.getElementById('btn-clear-chart').addEventListener('click', () => {
    chartHistory = [];
    chartVisibility = [true, true, true, true, true];
    drawChart();
    renderChartLegend();
  });

  // Start continuous chart scrolling (10Hz)
  startScrollTimer();

  // Run self-tests
  const testResult = runSelfTest();
  console.log(`\n🔧 自检完成: ${testResult.passed}/${testResult.total} 通过`);

  // Run 5 review passes
  setTimeout(runAllReviews, 100);
}

document.addEventListener('DOMContentLoaded', init);
</script>

</body>
</html>
